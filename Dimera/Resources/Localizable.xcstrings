    "Every change here moves the net-worth line on your dashboard instantly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Änderung hier bewegt die Nettovermögens-Linie auf deinem Dashboard sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cambio aquí mueve al instante la línea de patrimonio neto en tu panel."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cambio aquí mueve al instante la línea de patrimonio neto en tu panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque changement ici déplace instantanément la courbe de valeur nette de votre tableau de bord."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap perubahan di sini langsung menggerakkan garis kekayaan bersih di dasbor Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni modifica qui sposta subito la linea del patrimonio netto sulla tua dashboard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mudança aqui move a linha do patrimônio líquido no seu painel instantaneamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любое изменение здесь мгновенно отражается на линии капитала в вашей панели управления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
