    "Add one and Dimera tracks what it's really costing you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eines hinzu, und Dimera verfolgt, was es dich wirklich kostet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una y Dimera rastreará lo que realmente te cuesta."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega una y Dimera rastreará lo que realmente te cuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez-en un et Dimera suit ce qu'il vous coûte vraiment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan satu dan Dimera akan melacak berapa biaya sebenarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungine uno e Dimera traccia quanto ti costa davvero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma e o Dimera rastreia quanto ela realmente custa para você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте одну, и Dimera отследит, во сколько она вам реально обходится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tane ekle, Dimera gerçekte sana ne kadara mal olduğunu takip etsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一项，Dimera 就会追踪它实际花费了您多少钱。"
          }
        }
      }
    },
    "Add one to track renewal dates and cancellation windows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen hinzu, um Verlängerungstermine und Kündigungsfristen im Blick zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade uno para seguir las fechas de renovación y los plazos de cancelación."
