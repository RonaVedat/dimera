    "This looks like a receipt you already saved for %@ · %@. Add it again anyway?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht aus wie ein Beleg, den du schon gespeichert hast, für %@ · %@. Trotzdem erneut hinzufügen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece un recibo que ya guardaste para %@ · %@. ¿Añadirlo de todos modos?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece un recibo que ya guardaste para %@ · %@. ¿Agregarlo de todos modos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ressemble à un reçu déjà enregistré pour %@ · %@. L'ajouter quand même ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tampak seperti struk yang sudah Anda simpan untuk %@ · %@. Tetap tambahkan lagi?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra una ricevuta che hai già salvato per %@ · %@. Aggiungerla comunque?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso parece um recibo que você já salvou para %@ · %@. Adicionar mesmo assim?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, вы уже сохранили этот чек для %@ · %@. Всё равно добавить?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, %@ · %@ için zaten kaydettiğin bir makbuza benziyor. Yine de tekrar eklensin mi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来像是你已保存过的收据，属于 %@ · %@。仍要添加吗？"
          }
        }
      }
    },
