    "Renews at %@ %@ until cancelled. Cancel anytime in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich für %1$@ %2$@, bis du kündigst. Jederzeit in den Einstellungen kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva por %1$@ %2$@ hasta que lo canceles. Cancela cuando quieras en Ajustes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva por %1$@ %2$@ hasta que lo canceles. Cancela cuando quieras en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvelé à %1$@ %2$@ jusqu'à résiliation. Résiliez à tout moment dans les Réglages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperpanjang seharga %1$@ %2$@ hingga dibatalkan. Batalkan kapan saja di Pengaturan."
