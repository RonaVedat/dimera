    "Your family plan already covers you. You can cancel your own subscription to avoid paying twice.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Familienabo deckt dich bereits ab. Du kannst dein eigenes Abo kündigen, um nicht doppelt zu zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
