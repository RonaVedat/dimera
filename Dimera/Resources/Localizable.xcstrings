    "Flagged because '%@' matched a common %@ keyword and was over the %@ minimum we use to avoid noise.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert, weil „%1$@“ mit einem gängigen %2$@-Stichwort übereinstimmt und über dem Mindestbetrag von %3$@ liegt, den wir zur Vermeidung von Störungen verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Flagged because '%1$@' matched a common %2$@ keyword and was over the %3$@ minimum we use to avoid noise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcado porque «%1$@» coincide con una palabra clave habitual de %2$@ y supera el mínimo de %3$@ que usamos para evitar el ruido."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcado porque «%1$@» coincide con una palabra clave habitual de %2$@ y supera el mínimo de %3$@ que usamos para evitar el ruido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalé car « %1$@ » correspond à un mot-clé courant de %2$@ et dépasse le minimum de %3$@ que nous utilisons pour éviter le bruit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditandai karena '%1$@' cocok dengan kata kunci %2$@ yang umum dan melebihi batas minimum %3$@ yang kami gunakan untuk menghindari kebisingan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnalato perché '%1$@' corrisponde a una parola chiave comune per %2$@ ed è superiore al minimo di %3$@ che usiamo per evitare falsi positivi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinalizado porque '%1$@' correspondeu a uma palavra-chave comum de %2$@ e ficou acima do mínimo de %3$@ que usamos para evitar ruído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечено, поскольку «%1$@» соответствует распространённому ключевому слову категории %2$@ и превышает минимум в %3$@, который мы используем, чтобы избежать лишнего шума."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@' yaygın bir %2$@ anahtar kelimesiyle eşleştiği ve gürültüyü önlemek için kullandığımız %3$@ asgari tutarını aştığı için işaretlendi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已标记：「%1$@」匹配了常见的%2$@关键词，且金额超过我们用于减少噪音的最低标准 %3$@。"
          }
        }
      }
    },
