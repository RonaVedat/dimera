    "Dimera doesn't sell personal information, and manual transactions never leave your phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera verkauft keine persönlichen Daten, und manuell erfasste Transaktionen verlassen dein Telefon nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera no vende información personal, y las transacciones manuales nunca salen de tu teléfono."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera no vende información personal, y las transacciones manuales nunca salen de tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera ne vend aucune donnée personnelle, et vos transactions manuelles ne quittent jamais votre téléphone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera tidak menjual informasi pribadi, dan transaksi manual tidak pernah keluar dari ponsel Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera non vende informazioni personali e le transazioni manuali non lasciano mai il tuo telefono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dimera não vende informações pessoais, e as transações manuais nunca saem do seu celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera не продаёт личные данные, а вручную введённые операции никогда не покидают ваш телефон."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera kişisel bilgileri satmaz ve manuel işlemler telefonundan asla çıkmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera 不会出售个人信息，手动记录的交易也绝不会离开您的手机。"
          }
        }
      }
    },
    "Dimera is designed dark-first. System follows your device's setting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera ist in erster Linie für den Dunkelmodus gestaltet. „System“ folgt der Einstellung deines Geräts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera está diseñada pensando primero en el modo oscuro. Sistema sigue el ajuste de tu dispositivo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera está diseñada pensando primero en el modo oscuro. Sistema sigue el ajuste de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera est conçu d'abord pour le mode sombre. « Système » suit le réglage de votre appareil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera dirancang dengan mode gelap sebagai prioritas. Sistem mengikuti pengaturan perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera è progettata prima per lo scuro. Sistema segue l'impostazione del tuo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dimera foi criado com o modo escuro em mente. Sistema segue a configuração do seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera изначально создан для тёмной темы. «Системная» следует настройке вашего устройства."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera öncelikle koyu tema için tasarlandı. Sistem, cihazının ayarını izler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera 以深色模式为设计核心。“系统”选项会跟随设备设置。"
          }
        }
      }
    },
    "Dimera needs permission to send reminders. Enable notifications for Dimera in Settings, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera benötigt die Berechtigung, Erinnerungen zu senden. Aktiviere Mitteilungen für Dimera in den Einstellungen und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera necesita permiso para enviar recordatorios. Activa las notificaciones de Dimera en Ajustes y vuelve a intentarlo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera necesita permiso para enviar recordatorios. Activa las notificaciones de Dimera en Ajustes y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera a besoin de votre autorisation pour envoyer des rappels. Activez les notifications pour Dimera dans Réglages, puis réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera memerlukan izin untuk mengirim pengingat. Aktifkan notifikasi untuk Dimera di Pengaturan, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera ha bisogno del permesso per inviare promemoria. Attiva le notifiche per Dimera nelle Impostazioni, poi riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dimera precisa de permissão para enviar lembretes. Ative as notificações do Dimera nos Ajustes e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera нужно разрешение на отправку напоминаний. Включите уведомления для Dimera в настройках и попробуйте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera'nın hatırlatıcı gönderebilmesi için izne ihtiyacı var. Ayarlar'da Dimera için bildirimleri etkinleştirip tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimera 需要权限才能发送提醒。请在设置中为 Dimera 启用通知，然后重试。"
          }
        }
      }
    },
