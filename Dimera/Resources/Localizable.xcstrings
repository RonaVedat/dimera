    "See every category, not just the top three, with month-over-month change.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh alle Kategorien, nicht nur die Top drei, mit Veränderung im Monatsvergleich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta cada categoría, no solo las tres principales, con la variación mes a mes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta cada categoría, no solo las tres principales, con la variación mes a mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez toutes les catégories, pas seulement les trois premières, avec l'évolution mensuelle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat setiap kategori, bukan hanya tiga teratas, dengan perubahan dari bulan ke bulan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi ogni categoria, non solo le prime tre, con la variazione mese su mese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja cada categoria, não só as três principais, com a variação mês a mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите все категории, а не только топ-3, с изменением по месяцам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
