          }
        }
      }
    },
    "See what you saved, spent, and how your net worth moved.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, was du gespart und ausgegeben hast und wie sich dein Nettovermögen entwickelt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre qué ahorraste, qué gastaste y cómo se movió tu patrimonio neto."
