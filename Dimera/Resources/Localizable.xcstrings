    "Family members get Premium automatically when they open Dimera with their own Apple ID.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Familienmitglieder erhalten Premium automatisch, wenn sie Dimera mit ihrer eigenen Apple-ID öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus familiares obtienen Premium automáticamente al abrir Dimera con su propio Apple ID."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus familiares obtienen Premium automáticamente al abrir Dimera con su propio Apple ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les membres de votre famille obtiennent Premium automatiquement en ouvrant Dimera avec leur propre identifiant Apple."
          }
        },
        "id": {
          "stringUnit": {
