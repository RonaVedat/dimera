    "Try setting aside a bit more each month — even a small savings rate adds up.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche, jeden Monat etwas mehr zurückzulegen — auch eine kleine Sparquote summiert sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba a apartar un poco más cada mes — hasta una pequeña tasa de ahorro suma."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba a apartar un poco más cada mes — hasta una pequeña tasa de ahorro suma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de mettre un peu plus de côté chaque mois — même un petit taux d'épargne s'accumule."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba sisihkan sedikit lebih banyak setiap bulan — bahkan tingkat tabungan kecil pun akan bertambah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova a mettere da parte un po' di più ogni mese — anche un piccolo tasso di risparmio si accumula."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente guardar um pouco mais a cada mês — mesmo uma pequena taxa de poupança faz diferença."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте откладывать чуть больше каждый месяц — даже небольшая норма сбережений накапливается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ay biraz daha fazla ayırmayı dene — küçük bir tasarruf oranı bile birikir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试每月多存一点——即使储蓄率不高，也会积少成多。"
