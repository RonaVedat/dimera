    "Daily Review and Weekly Digest wait until %@ if they'd otherwise fire between %@ and %@. Renewal reminders are unaffected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagesüberblick und Wochenzusammenfassung warten bis %1$@, falls sie sonst zwischen %2$@ und %3$@ ausgelöst würden. Verlängerungserinnerungen sind davon nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Daily Review and Weekly Digest wait until %1$@ if they'd otherwise fire between %2$@ and %3$@. Renewal reminders are unaffected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Resumen diario y el Resumen semanal esperan hasta las %1$@ si de otro modo se activarían entre las %2$@ y las %3$@. Los recordatorios de renovación no se ven afectados."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El Resumen diario y el Resumen semanal esperan hasta las %1$@ si de otro modo se activarían entre las %2$@ y las %3$@. Los recordatorios de renovación no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bilan quotidien et le résumé hebdomadaire attendent jusqu'à %1$@ s'ils devaient se déclencher entre %2$@ et %3$@. Les rappels de renouvellement ne sont pas concernés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulasan Harian dan Ringkasan Mingguan menunggu hingga %1$@ jika seharusnya muncul antara %2$@ dan %3$@. Pengingat perpanjangan tidak terpengaruh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Riepilogo giornaliero e il Riepilogo settimanale attendono fino alle %1$@ se dovrebbero altrimenti attivarsi tra le %2$@ e le %3$@. I promemoria di rinnovo non sono interessati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Resumo Diário e o Resumo Semanal esperam até %1$@ caso disparassem entre %2$@ e %3$@. Os lembretes de renovação não são afetados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежедневный обзор и еженедельная сводка откладываются до %1$@, если должны были сработать между %2$@ и %3$@. На напоминания о продлении это не влияет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük Özet ve Haftalık Özet, %2$@ ile %3$@ arasında tetiklenecekse %1$@ saatine kadar beklenir. Yenileme hatırlatıcıları bundan etkilenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若每日回顾和每周摘要本应在 %2$@ 至 %3$@ 之间发送，则会推迟到 %1$@。续订提醒不受影响。"
          }
        }
      }
    },
