    "Add an asset first to link a goal to it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst einen Vermögenswert hinzu, um ein Ziel damit zu verknüpfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade primero un activo para vincularle un objetivo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega primero un activo para vincularle un objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d'abord un actif pour y lier un objectif."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan aset terlebih dahulu untuk menautkan target ke sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima un'attività per collegarci un obiettivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um ativo primeiro para vincular uma meta a ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте актив, чтобы привязать к нему цель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hedefi bağlamak için önce bir varlık ekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先添加一项资产，才能将目标与之关联。"
          }
        }
      }
    },
