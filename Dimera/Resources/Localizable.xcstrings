    "Delays routine reminders until morning if they'd otherwise fire overnight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebt routinemäßige Erinnerungen auf den Morgen, falls sie sonst nachts ausgelöst würden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrasa los recordatorios rutinarios hasta la mañana si de otro modo se activarían de madrugada."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrasa los recordatorios rutinarios hasta la mañana si de otro modo se activarían de madrugada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporte les rappels habituels au matin s'ils devaient se déclencher pendant la nuit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunda pengingat rutin hingga pagi jika seharusnya muncul di tengah malam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritarda i promemoria di routine fino al mattino se altrimenti si attiverebbero di notte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adia lembretes de rotina até de manhã caso disparassem durante a madrugada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откладывает обычные напоминания до утра, если они должны были сработать ночью."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gece tetiklenecek rutin hatırlatıcıları sabaha erteler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若常规提醒本应在夜间触发，将推迟到早上。"
          }
        }
      }
    },
