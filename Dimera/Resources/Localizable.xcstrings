    },
    "If this was tracked as recurring, that reminder is removed too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls dies als wiederkehrend erfasst war, wird die Erinnerung ebenfalls entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esto se registraba como recurrente, ese recordatorio también se eliminará."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esto se registraba como recurrente, ese recordatorio también se eliminará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ceci était suivi comme récurrent, ce rappel sera également supprimé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ini dilacak sebagai berulang, pengingat tersebut juga akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se era tracciata come ricorrente, anche quel promemoria viene rimosso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se isso era rastreado como recorrente, esse lembrete também será removido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если это отслеживалось как повторяющийся платёж, напоминание также будет удалено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tekrarlanan olarak takip ediliyorsa, o hatırlatıcı da kaldırılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果这被标记为定期项目，相应提醒也会被移除。"
          }
        }
      }
    },
