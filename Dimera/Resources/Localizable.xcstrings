    "Purchases are turned off on this device. You can keep using Dimera for free.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe sind auf diesem Gerät deaktiviert. Du kannst Dimera weiterhin kostenlos nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras están desactivadas en este dispositivo. Puedes seguir usando Dimera gratis."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras están desactivadas en este dispositivo. Puedes seguir usando Dimera gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats sont désactivés sur cet appareil. Vous pouvez continuer à utiliser Dimera gratuitement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian dinonaktifkan di perangkat ini. Kamu tetap bisa memakai Dimera secara gratis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli acquisti sono disattivati su questo dispositivo. Puoi continuare a usare Dimera gratuitamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As compras estão desativadas neste dispositivo. Você pode continuar usando o Dimera de graça."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупки на этом устройстве отключены. Вы можете и дальше пользоваться Dimera бесплатно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
