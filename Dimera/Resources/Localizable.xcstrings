    "How close you are, and when you'll get there.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie nah du dran bist — und wann du es schaffst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo cerca que estás, y cuándo lo lograrás."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué tan cerca estás, y cuándo lo lograrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel point vous êtes proche, et quand vous y arriverez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa dekat Anda, dan kapan Anda akan mencapainya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto sei vicino, e quando ci arriverai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quão perto você está, e quando vai chegar lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько вы близки — и когда вы этого достигнете."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar yaklaştığın ve ne zaman ulaşacağın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已经完成多少，以及何时能达成目标。"
          }
        }
      }
    },
    "How involved do you want to be?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie involviert möchtest du sein?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto quieres involucrarte?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto quieres involucrarte?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel point voulez-vous être impliqué ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa terlibat Anda ingin berperan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto vuoi essere coinvolto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto você quer se envolver?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько активно вы хотите участвовать?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar dahil olmak istersin?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您希望参与程度如何？"
          }
        }
      }
    },
    "How would you like to track your progress?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie möchtest du deinen Fortschritt verfolgen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo te gustaría seguir tu progreso?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo te gustaría seguir tu progreso?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment souhaitez-vous suivre votre progression ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana Anda ingin melacak progres Anda?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
