    "Couldn't load prices. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Preise konnten nicht geladen werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los precios. Revisa tu conexión y vuelve a intentarlo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los precios. Revisa tu conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les prix. Vérifiez votre connexion et réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga tidak dapat dimuat. Periksa koneksimu lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare i prezzi. Controlla la connessione e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os preços. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить цены. Проверьте подключение и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyatlar yüklenemedi. Bağlantını kontrol edip tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载价格。请检查网络连接后重试。"
