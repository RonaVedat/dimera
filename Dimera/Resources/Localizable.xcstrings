          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como você gostaria de acompanhar seu progresso?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как вы хотите отслеживать прогресс?"
          }
